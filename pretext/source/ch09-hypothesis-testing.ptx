male = chinstrap.query("Sex == 'MALE'")
weights_male = male["Body Mass (g)"] / 1000
weights_male.mean()
          </input>
        </program>
    <pre>
np.float64(3.9389705882352937)
    </pre>
        </listing>
        <listing>
          <caption>Python Code</caption>
